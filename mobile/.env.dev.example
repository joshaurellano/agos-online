# Copy to .env.dev and fill in with your DEV Supabase project.
# (.env.dev is git-ignored.) Keep any other keys your real .env has, e.g. API URLs,
# pointing at dev/test services where they exist.
SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-dev-anon-key
MODEL_API_URL=https://MODEL_LINK
FORECAST_API_URL=https://WEATHER_FORECAST_ENDPOINT
FORECAST_FLOOD_API_URL=https://FLOOD_FORECAST_ENDPOINT
